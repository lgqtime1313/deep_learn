import torch
x = torch.arange(4.0)
x


x.requires_grad_(True)  # 等价于 x=torch.arange(4.0,requires_grad=True)
x.grad


x


y = 2*torch.dot(x,x)


y


y.backward()  # 计算储存在x.grad中 同时运行一遍计算图被释放
x.grad


x.grad == 4*x


x.grad.zero_()


y = x.sum()


y.backward()  #  反向传播


x.grad  # grad会累加 需要清空


x.grad.zero_()
y = x*x  # shift + ctrl + -分割代码块


y.sum().backward()
x.grad


y


y.backward(gradient=torch.ones(len(x)))  # 传入梯度为1


x.grad


torch.ones(len(x))


x


x.grad.zero_()


y = x*x


u = y.detach()  # 把这个参数当成常量对待


u


z = u*x


z,z.sum()


z.sum().backward()


x.grad == u


x.grad.zero_()


y.sum().backward()


x.grad == 2 * x


def f(a):
    b = a * 2
    while b.norm() < 1000:
        b = b * 2
    if b.sum() > 0:
        c = b
    else:
        c = 100 * b
    return c


a = torch.randn(size=(),requires_grad=True)


a


d = f(a)


d.backward()


a.grad == d / a



