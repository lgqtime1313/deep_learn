import os, pandas as pd


os.makedirs(os.path.join('..','data'),exist_ok=True)


data_file = os.path.join('..','data','hosue_tiny.csv')


with open(data_file,'w') as f:
    f.write("Numrooms,alley,price\n")  # 只有NA代表nan,NAN就是字符串 是错的
    f.write('NA,pave,127500\n')
    f.write('2,NA,100\n')
    f.write('3,NA,200\n')
    f.write('NA,NA,NA')


data = pd.read_csv(data_file)


data


inputs, outputs = data.iloc[:,0:2],data.iloc[:,-1]


outputs


outputs.dropna()


outputs


inputs = inputs.fillna(inputs.mean(numeric_only=True))  # 新版本 或者使用特定列 不过好像没啥用 


inputs


inputs['Numrooms'] = inputs['Numrooms'].fillna(inputs['Numrooms'].mean())


inputs


inputs = pd.get_dummies(inputs,dummy_na=True).astype(int)  # 转换成独热编码


inputs


import torch


x = torch.tensor(inputs.to_numpy(dtype=float))


y = torch.tensor(outputs.to_numpy(dtype=float))


x,y



